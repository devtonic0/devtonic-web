{
  "name": "devtonic-web",
  "version": "0.1.0",
  "description": "Devtonic in your browser \u2014 an AI mission-control workspace for building with coding agents (Hermes). Open source.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "devtonic-web": "server/index.mjs"
  },
  "files": [
    "dist/**",
    "server/**",
    "assets/**"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.mjs --open",
    "serve": "node server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@emmetio/codemirror6-plugin": "^0.4.1",
    "3d-force-graph": "^1.73.4",
    "codemirror": "^6.0.2",
    "d3-force": "^3.0.0",
    "force-graph": "^1.51.4",
    "highlight.js": "^11.10.0",
    "marked": "^14.1.2",
    "rc-dock": "^3.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "path-browserify": "^1.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/devtonic0/devtonic-web.git"
  },
  "homepage": "https://github.com/devtonic0/devtonic-web",
  "engines": {
    "node": ">=20"
  }
